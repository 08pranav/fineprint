# Copy to .env for local runs. Never commit .env.
# Leave LLM_API_KEY empty to run in rules-only mode (everything still works, English explanations only).

# Any OpenAI-compatible endpoint. Examples (check your provider's docs for current model names):
#   Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1
#   Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenAI:  leave LLM_BASE_URL empty
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=45
LLM_BATCH_SIZE=25

# Input limits
MAX_UPLOAD_MB=5
MAX_CHARS=60000
